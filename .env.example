# Copy this file to `.env` and fill in at least one provider API key.
#
#   cp .env.example .env          # Unix / Git Bash
#   Copy-Item .env.example .env   # PowerShell
#
# You don't have to edit this file: Makker prompts for a key when a model
# needs one and saves it for future runs. Pick and switch models with `/model`
# in the app. Set whichever provider key(s) you'll use.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Local models via Ollama (https://ollama.com) need no key — just run `ollama serve`.

# Makker reads only the provider keys above from a workspace .env. Set
# MAKKER_MODEL, the dev/CI override for its model, in your shell instead.

# Model for the live LLM tests in tests/live/ (the test suite reads this file).
# MAKKER_LIVE_MODEL=<provider>:<model-id>
# OpenRouter IDs use openrouter:<vendor>/<model-id>.
